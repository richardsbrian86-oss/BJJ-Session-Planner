# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (auto-provisioned by Replit)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# HMAC signing secret for instructor tokens (required in production)
APP_SECRET=change-me-in-production

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe secret key — set via the Replit Stripe integration
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (required in production)
# Obtain from the Stripe dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe publishable key for the client portal frontend (optional)
# The portal gracefully bypasses payment if this is missing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Auth audit tuning ─────────────────────────────────────────────────────────
# All values are in milliseconds. Omit any variable to use the default.

# Number of failures within AUTH_ALERT_WINDOW_MS that triggers an alert email.
# Default: 5
AUTH_ALERT_THRESHOLD=5

# Rolling window over which failures are counted.
# Default: 600000 (10 minutes)
AUTH_ALERT_WINDOW_MS=600000

# Minimum gap between alert emails for the same (IP, instructor) pair.
# Default: 3600000 (1 hour)
AUTH_ALERT_COOLDOWN_MS=3600000

# How often the cleanup job prunes stale rows from auth_failures.
# Must be a positive finite number. Invalid values (0, negative, NaN, non-numeric)
# are rejected with a warning and the default is used instead.
# Default: AUTH_ALERT_WINDOW_MS + AUTH_ALERT_COOLDOWN_MS (4200000 = 70 minutes)
AUTH_FAILURE_CLEANUP_INTERVAL_MS=4200000
